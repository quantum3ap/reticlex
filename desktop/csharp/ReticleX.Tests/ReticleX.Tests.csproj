<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ReticleX.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReticleX.Core\ReticleX.Core.csproj" />
  </ItemGroup>

  <!--
    The native core lives beside the test binary so the interop tests exercise
    the real library. CI builds it first and points ReticleXNativeLibrary at
    the output; when it is absent those tests report that fact rather than
    silently passing.
  -->
  <ItemGroup Condition="'$(ReticleXNativeLibrary)' != '' And Exists('$(ReticleXNativeLibrary)')">
    <None Include="$(ReticleXNativeLibrary)"
          CopyToOutputDirectory="PreserveNewest"
          Link="$([System.IO.Path]::GetFileName('$(ReticleXNativeLibrary)'))" />
  </ItemGroup>

  <!-- The catalogues and presets the tests read straight from the repository. -->
  <ItemGroup>
    <None Include="..\..\..\localization\*.json" LinkBase="localization" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\presets\builtin.json" LinkBase="presets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
